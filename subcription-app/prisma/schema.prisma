// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// App configuration
// ---------------------------------------------------------------------------

// One row per shop, backing the admin Settings screen. Shopify is the source of
// truth for plans and contracts; this table only holds our own preferences.
model ShopSettings {
  id    String @id @default(cuid())
  shop  String @unique

  // Customer portal permissions
  portalEnabled           Boolean @default(true)
  allowCancel             Boolean @default(true)
  allowSkipCycle          Boolean @default(true)
  allowPause              Boolean @default(true)
  allowChangeFrequency    Boolean @default(true)
  allowChangeAddress      Boolean @default(true)
  allowChangePaymentMethod Boolean @default(true)
  minCyclesBeforeCancel   Int     @default(0)

  // Failed payment handling
  dunningMaxRetries        Int @default(3)
  dunningRetryIntervalDays Int @default(3)

  // PDP widget copy
  widgetHeading          String @default("Subscribe & Save")
  widgetOneTimeLabel     String @default("One-time purchase")
  widgetSubscribeLabel   String @default("Subscribe")
  widgetShowDiscountBadge Boolean @default(true)

  // Branding -- shown in the admin dashboard nav and the customer account
  // portal (topbar, sidebar, sign-in/create-account/forgot/reset password
  // pages) in place of the plain "CLRTY" text wordmark once set.
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Selling plan mirror
//
// Created and updated through the Admin GraphQL API (sellingPlanGroupCreate /
// sellingPlanGroupUpdate). Mirrored here so admin screens can list and search
// plans without paging the Admin API on every render.
// ---------------------------------------------------------------------------

model SellingPlanGroup {
  id        String @id @default(cuid())
  shop      String
  shopifyId String @unique // gid://shopify/SellingPlanGroup/...

  name         String
  merchantCode String
  appName      String?
  description  String?
  // JSON-encoded string[] of the option names shown to buyers (e.g. ["Delivery every"])
  options      String  @default("[]")
  // JSON-encoded string[] of product GIDs this group is attached to
  productIds   String  @default("[]")
  // Cached from the product at save time so the selling-plans list screen can
  // render without paging the Admin API for every configured product.
  productTitle String?
  position     Int     @default(0)

  plans SellingPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model SellingPlan {
  id        String @id @default(cuid())
  shopifyId String @unique // gid://shopify/SellingPlan/...

  group   SellingPlanGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  name String

  // Billing / delivery cadence. Interval is one of DAY | WEEK | MONTH | YEAR.
  billingInterval       String
  billingIntervalCount  Int
  deliveryInterval      String
  deliveryIntervalCount Int

  // Discount: NONE | PERCENTAGE | FIXED_AMOUNT | PRICE
  pricingPolicyType String @default("NONE")
  discountValue     Float?

  minCycles Int?
  maxCycles Int?
  position  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Subscription mirror, kept in sync by webhooks
// ---------------------------------------------------------------------------

model SubscriptionContract {
  id        String @id @default(cuid())
  shop      String
  shopifyId String @unique // gid://shopify/SubscriptionContract/...

  customerShopifyId String?
  customerEmail     String?
  customerName      String?

  // ACTIVE | PAUSED | CANCELLED | EXPIRED | FAILED
  status       String
  currencyCode String @default("USD")

  nextBillingDate      DateTime?
  billingInterval      String?
  billingIntervalCount Int?

  sellingPlanGroupShopifyId String?
  originOrderShopifyId      String?

  // JSON snapshot of contract lines (title, variant GID, quantity, price) so the
  // subscriptions list can render without a per-row Admin API call.
  linesJson String?

  lastPaymentStatus String?
  totalAmount       Float?

  pausedAt    DateTime?
  cancelledAt DateTime?

  // Customer-supplied reason from the portal's cancel flow. Shopify's contract
  // object has no field for this, so it only ever exists in our own mirror.
  cancellationReason String?

  billingAttempts BillingAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, status])
  @@index([customerShopifyId])
}

// ---------------------------------------------------------------------------
// Customer portal login -- entirely separate from Shopify's own customer
// accounts. Not email-verified at signup (no email sending is set up yet):
// a signup only checks whether the email matches an existing subscriber on
// file, it does not prove the signer owns that inbox. Do not treat this as
// safe for real customer data until email verification is added.
// ---------------------------------------------------------------------------

model PortalCustomer {
  id           String @id @default(cuid())
  shop         String
  email        String // stored lowercased
  passwordHash String
  name         String

  // Set at signup if the email matches a SubscriptionContract.customerEmail
  // for this shop. Null means the account has no linked subscriptions yet.
  customerShopifyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetTokens PortalPasswordResetToken[]

  @@unique([shop, email])
  @@index([customerShopifyId])
}

// One-time token backing the "forgot password" email flow. Only a hash of the
// token is stored -- like a password, the raw value must never be
// recoverable from the database, only comparable against what a link
// supplies. Consumed (or expired) tokens are left in place with `usedAt` set
// rather than deleted, so a replayed link can be told apart from one that
// never existed.
model PortalPasswordResetToken {
  id     String @id @default(cuid())
  tokenHash String @unique

  portalCustomer   PortalCustomer @relation(fields: [portalCustomerId], references: [id], onDelete: Cascade)
  portalCustomerId String

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([portalCustomerId])
}

model BillingAttempt {
  id        String  @id @default(cuid())
  shop      String
  shopifyId String? @unique // gid://shopify/SubscriptionBillingAttempt/...

  contract           SubscriptionContract? @relation(fields: [contractShopifyId], references: [shopifyId], onDelete: SetNull)
  contractShopifyId  String?

  // SUCCESS | FAILURE
  status          String
  orderShopifyId  String?
  amount          Float?
  currencyCode    String?
  errorCode       String?
  errorMessage    String?
  attemptedAt     DateTime @default(now())

  @@index([shop, status])
  @@index([contractShopifyId])
}

// Recurring orders seen via orders/create, for dashboard analytics.
model SubscriptionOrder {
  id             String @id @default(cuid())
  shop           String
  orderShopifyId String @unique // gid://shopify/Order/...
  orderName      String?

  contractShopifyId String?
  totalPrice        Float?
  currencyCode      String?
  processedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([shop, processedAt])
  @@index([contractShopifyId])
}

// Shopify delivers webhooks at least once. Handlers record the webhook id here
// and skip anything they have already processed.
model ProcessedWebhook {
  webhookId  String   @id
  shop       String
  topic      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}