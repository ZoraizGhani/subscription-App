{% comment %}
  Self-contained purchase widget: image-swatch variant picker, quantity, a
  Subscribe & Save vs one-time-purchase choice, and its own add-to-cart button.

  If the product has no selling plan group at all, this block renders nothing
  at all -- no fallback buy box of its own. The theme's own default variant
  picker / add-to-cart button (already on the page) is what shows for those
  products; this widget only takes over the purchase UI when there's actually
  something to subscribe to.

  Every label/heading/button-copy string below comes from block.settings (set
  per-instance in the theme editor) rather than being hardcoded, so merchants
  can reword this for products where e.g. the first option isn't a "flavor".
  Only genuinely product-derived values (price, discount %, delivery cadence,
  which plan is the best deal) are computed live from Shopify's own product/
  selling-plan data in subscription-widget.js -- never hardcoded.

  Because this renders its own buy button, merchants should remove or hide the
  theme's default variant picker / buy buttons block specifically on products
  that DO have a subscription, to avoid two purchase forms on the same page --
  for products with no subscription, both can coexist since this block stays
  empty for them.
{% endcomment %}

{%- assign selling_plan_group = product.selling_plan_groups.first -%}
{%- assign has_subscription = false -%}
{%- if selling_plan_group and selling_plan_group.selling_plans.size > 0 -%}
  {%- assign has_subscription = true -%}
{%- endif -%}

{%- if has_subscription -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}

  <div
    class="subscription-widget"
    style="--subscription-widget-accent: {{ block.settings.accent_color }}; --subscription-widget-swatch-selected: {{ block.settings.swatch_selected_color }};"
    data-subscription-widget
    data-has-subscription="true"
    data-section-id="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-subscription-widget-product>
      {{ product | json }}
    </script>
    <script type="application/json" data-subscription-widget-settings>
      {
        "subscribeTitle": {{ block.settings.subscribe_title | json }},
        "oneTimeLabel": {{ block.settings.one_time_label | json }},
        "subscribeButtonLabel": {{ block.settings.subscribe_button_label | json }},
        "oneTimeButtonLabel": {{ block.settings.one_time_button_label | json }},
        "priceUnitSuffix": {{ block.settings.price_unit_suffix | json }},
        "bestValueBadgeText": {{ block.settings.best_value_badge_text | json }},
        "showBestValueBadge": {{ block.settings.show_best_value_badge | json }},
        "moneyFormat": {{ shop.money_format | json }}
      }
    </script>

    {%- if product.has_only_default_variant == false -%}
      {%- assign first_option = product.options_with_values.first -%}
      {%- assign new_values_list = block.settings.new_values | split: "," -%}

      {%- comment -%}
        Merchants can name an exact flavor value in the block settings, but
        most won't bother -- so with nothing configured, default to the same
        pattern the design shows: the first flavor is "Most Favourite" and
        every other flavor is "New", rather than showing no badges at all.
      {%- endcomment -%}
      {%- assign favourite_value = block.settings.favourite_value -%}
      {%- if favourite_value == blank -%}
        {%- assign favourite_value = first_option.values.first -%}
      {%- endif -%}
      {%- assign new_values_configured = false -%}
      {%- if block.settings.new_values != blank -%}
        {%- assign new_values_configured = true -%}
      {%- endif -%}

      <div class="subscription-widget__section">
        <p class="subscription-widget__flavor-heading">
          {{ block.settings.flavor_section_label }}
          <span class="subscription-widget__flavor-heading-value" data-selected-flavor-value>{{ current_variant.options[0] }}</span>
        </p>
        <div class="subscription-widget__swatch-grid" data-option-index="0">
          {%- for value in first_option.values -%}
            {%- assign swatch_variant = nil -%}
            {%- for v in product.variants -%}
              {%- if swatch_variant == nil and v.options[0] == value -%}
                {%- assign swatch_variant = v -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign swatch_image = swatch_variant.featured_image | default: product.featured_image -%}

            {%- assign is_favourite = false -%}
            {%- if value == favourite_value -%}
              {%- assign is_favourite = true -%}
            {%- endif -%}
            {%- assign is_new = false -%}
            {%- if new_values_configured -%}
              {%- for new_value in new_values_list -%}
                {%- assign new_value_trimmed = new_value | strip -%}
                {%- if new_value_trimmed == value -%}
                  {%- assign is_new = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- elsif is_favourite == false -%}
              {%- assign is_new = true -%}
            {%- endif -%}

            <button
              type="button"
              class="subscription-widget__swatch{% if value == current_variant.options[0] %} is-selected{% endif %}"
              data-option-value="{{ value | escape }}"
              data-swatch-label="{{ value | escape }}"
            >
              {%- if is_favourite -%}
                <span class="subscription-widget__swatch-badge subscription-widget__swatch-badge--favourite">{{ block.settings.favourite_badge_text }}</span>
              {%- elsif is_new -%}
                <span class="subscription-widget__swatch-badge subscription-widget__swatch-badge--new">{{ block.settings.new_badge_text }}</span>
              {%- endif -%}
              <span class="subscription-widget__swatch-image">
                {%- if swatch_image -%}
                  {{ swatch_image | image_url: width: 160 | image_tag: loading: "lazy", alt: value, widths: "80,160" }}
                {%- endif -%}
              </span>
              <span class="subscription-widget__swatch-name">{{ value }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      {%- for option in product.options_with_values -%}
        {%- if forloop.index0 > 0 -%}
          <div class="subscription-widget__section" data-option-index="{{ forloop.index0 }}">
            <p class="subscription-widget__section-label">{{ option.name }}</p>
            <div class="subscription-widget__option-values">
              {%- for value in option.values -%}
                <button
                  type="button"
                  class="subscription-widget__option-value{% if value == current_variant.options[forloop.parentloop.index0] %} is-selected{% endif %}"
                  data-option-value="{{ value | escape }}"
                >
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    <div class="subscription-widget__section">
      <div class="subscription-widget__quantity-row">
        <p class="subscription-widget__quantity-label">{{ block.settings.quantity_label }}</p>
        <div class="subscription-widget__quantity">
          <button type="button" data-quantity-decrease aria-label="Decrease quantity">&minus;</button>
          <input type="number" min="1" value="1" data-quantity-input aria-label="Quantity">
          <button type="button" data-quantity-increase aria-label="Increase quantity">+</button>
        </div>
      </div>
      {%- if block.settings.mix_flavors_note != blank -%}
        <p class="subscription-widget__mix-note">{{ block.settings.mix_flavors_note }}</p>
      {%- endif -%}
    </div>

    <div class="subscription-widget__section">
      <p class="subscription-widget__section-label">{{ block.settings.plan_section_label }}</p>

      <div class="subscription-widget__plan-cards">
      <label class="subscription-widget__plan-card" data-plan-card="subscribe">
        <span class="subscription-widget__plan-card-radio">
          <input type="radio" name="subscription-widget-mode-{{ block.id }}" value="subscribe" checked data-plan-mode="subscribe">
        </span>
        <span class="subscription-widget__plan-card-body">
          <span class="subscription-widget__plan-card-top">
            <span class="subscription-widget__plan-card-title">
              {{ block.settings.subscribe_title }}
              <span data-discount-percent></span>
            </span>
            <span class="subscription-widget__badge" data-best-value-badge hidden>{{ block.settings.best_value_badge_text }}</span>
          </span>
          <span class="subscription-widget__plan-card-price">
            <span class="subscription-widget__price-now" data-plan-price></span>
            <span class="subscription-widget__price-compare" data-compare-price hidden></span>
            <span class="subscription-widget__price-unit" data-price-unit hidden></span>
          </span>
          <span class="subscription-widget__deliver-row">
            <span class="subscription-widget__deliver-label">{{ block.settings.deliver_every_label }}</span>
            <select class="subscription-widget__deliver-select" data-plan-select aria-label="{{ block.settings.deliver_every_label }}">
              {%- for plan in selling_plan_group.selling_plans -%}
                <option value="{{ plan.id }}">{{ plan.name | remove_first: "Every " }}</option>
              {%- endfor -%}
            </select>
          </span>
        </span>
      </label>

      {%- if block.settings.show_one_time_option -%}
        <label class="subscription-widget__plan-card" data-plan-card="onetime">
          <span class="subscription-widget__plan-card-radio">
            <input type="radio" name="subscription-widget-mode-{{ block.id }}" value="onetime" data-plan-mode="onetime">
          </span>
          <span class="subscription-widget__plan-card-body">
            <span class="subscription-widget__plan-card-top">
              <span class="subscription-widget__plan-card-title">{{ block.settings.one_time_label }}</span>
            </span>
            <span class="subscription-widget__plan-card-price">
              <span class="subscription-widget__price-now" data-onetime-price>{{ current_variant.price | money }}</span>
            </span>
          </span>
        </label>
      {%- endif -%}
      </div>

      {%- if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank -%}
        <ul class="subscription-widget__benefits">
          {%- if block.settings.benefit_1 != blank -%}
            <li>
              <svg class="subscription-widget__benefit-icon" width="8" height="9" viewBox="0 0 8 9" fill="none" aria-hidden="true">
                <path d="M7.79883 0.240234C5.88867 2.9668 3.92578 5.49023 1.91016 7.81055C1.75781 7.98633 1.625 8.07422 1.51172 8.07422C1.38281 8.07422 1.15039 7.73438 0.814453 7.05469C0.271484 5.95703 0 5.30078 0 5.08594C0 5.00781 0.0527344 4.91602 0.158203 4.81055C0.384766 4.57227 0.544922 4.45312 0.638672 4.45312C0.724609 4.45312 0.816406 4.58984 0.914062 4.86328C1.17188 5.55859 1.44336 6.17773 1.72852 6.7207C3.70508 4.7207 5.66016 2.48047 7.59375 0L7.79883 0.240234Z" fill="#15803D" />
              </svg>
              {{ block.settings.benefit_1 }}
            </li>
          {%- endif -%}
          {%- if block.settings.benefit_2 != blank -%}
            <li>
              <svg class="subscription-widget__benefit-icon" width="8" height="9" viewBox="0 0 8 9" fill="none" aria-hidden="true">
                <path d="M7.79883 0.240234C5.88867 2.9668 3.92578 5.49023 1.91016 7.81055C1.75781 7.98633 1.625 8.07422 1.51172 8.07422C1.38281 8.07422 1.15039 7.73438 0.814453 7.05469C0.271484 5.95703 0 5.30078 0 5.08594C0 5.00781 0.0527344 4.91602 0.158203 4.81055C0.384766 4.57227 0.544922 4.45312 0.638672 4.45312C0.724609 4.45312 0.816406 4.58984 0.914062 4.86328C1.17188 5.55859 1.44336 6.17773 1.72852 6.7207C3.70508 4.7207 5.66016 2.48047 7.59375 0L7.79883 0.240234Z" fill="#15803D" />
              </svg>
              {{ block.settings.benefit_2 }}
            </li>
          {%- endif -%}
          {%- if block.settings.benefit_3 != blank -%}
            <li>
              <svg class="subscription-widget__benefit-icon" width="8" height="9" viewBox="0 0 8 9" fill="none" aria-hidden="true">
                <path d="M7.79883 0.240234C5.88867 2.9668 3.92578 5.49023 1.91016 7.81055C1.75781 7.98633 1.625 8.07422 1.51172 8.07422C1.38281 8.07422 1.15039 7.73438 0.814453 7.05469C0.271484 5.95703 0 5.30078 0 5.08594C0 5.00781 0.0527344 4.91602 0.158203 4.81055C0.384766 4.57227 0.544922 4.45312 0.638672 4.45312C0.724609 4.45312 0.816406 4.58984 0.914062 4.86328C1.17188 5.55859 1.44336 6.17773 1.72852 6.7207C3.70508 4.7207 5.66016 2.48047 7.59375 0L7.79883 0.240234Z" fill="#15803D" />
              </svg>
              {{ block.settings.benefit_3 }}
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <button type="button" class="subscription-widget__submit" data-add-to-cart>
      {{ block.settings.subscribe_button_label }}
    </button>

    <div class="subscription-widget__footer-meta">
      <span>Variant {{ current_variant.id }}</span>
      {%- if block.settings.reassurance_text != blank -%}<span>{{ block.settings.reassurance_text }}</span>{%- endif -%}
      {%- if block.settings.cancel_note != blank -%}<span>{{ block.settings.cancel_note }}</span>{%- endif -%}
    </div>

    <p class="subscription-widget__status" data-status role="status" aria-live="polite"></p>
  </div>

  <script src="{{ 'subscription-widget.js' | asset_url }}" defer></script>
  <link rel="stylesheet" href="{{ 'subscription-widget.css' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&display=swap" rel="stylesheet">
{%- else -%}
  {%- comment -%} Nothing to subscribe to -- stays empty so the theme's own buy box is what shows. Keeps a hook so the block is still selectable in the theme editor. {%- endcomment -%}
  <div data-subscription-widget-inactive {{ block.shopify_attributes }}></div>
{%- endif -%}

{% schema %}
{
  "name": "Subscription widget",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Flavor / variant section" },
    { "type": "text", "id": "flavor_section_label", "label": "Flavor section heading", "default": "Flavors:" },
    { "type": "color", "id": "swatch_selected_color", "label": "Selected flavor border / \"most favourite\" badge color", "default": "#8C9E56" },
    { "type": "text", "id": "favourite_value", "label": "\"Most favourite\" flavor", "info": "Must exactly match one flavor value. Leave blank to hide." },
    { "type": "text", "id": "favourite_badge_text", "label": "Most-favourite badge text", "default": "Most Favourite" },
    { "type": "text", "id": "new_values", "label": "\"New\" flavors", "info": "Comma-separated, must exactly match flavor values. Leave blank to hide." },
    { "type": "text", "id": "new_badge_text", "label": "New badge text", "default": "New" },
    { "type": "text", "id": "quantity_label", "label": "Quantity label", "default": "Quantity Selector" },
    { "type": "text", "id": "mix_flavors_note", "label": "Mix-flavors note (leave blank to hide)", "default": "Mix flavors freely — 1 pouch selected, same price per pouch either way." },

    { "type": "header", "content": "Plan section" },
    { "type": "text", "id": "plan_section_label", "label": "Plan section heading", "default": "2. Choose your plan" },
    { "type": "text", "id": "subscribe_title", "label": "Subscribe option title", "default": "Subscribe & Save" },
    { "type": "checkbox", "id": "show_one_time_option", "label": "Show one-time purchase option", "default": true },
    { "type": "text", "id": "one_time_label", "label": "One-time purchase label", "default": "One-time purchase" },
    { "type": "text", "id": "deliver_every_label", "label": "Delivery cadence label", "default": "Deliver every" },
    { "type": "text", "id": "price_unit_suffix", "label": "Price unit suffix (e.g. \"pouch\", \"bottle\") -- leave blank to hide" },
    { "type": "checkbox", "id": "show_best_value_badge", "label": "Show \"best value\" badge on the best-discount plan", "default": true },
    { "type": "text", "id": "best_value_badge_text", "label": "Best value badge text", "default": "Best value" },

    { "type": "header", "content": "Benefits list" },
    { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Free shipping on every order" },
    { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Pause, skip, or cancel anytime" },
    { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "30-day empty-bottle guarantee" },

    { "type": "header", "content": "Buttons & reassurance copy" },
    { "type": "text", "id": "subscribe_button_label", "label": "Subscribe button label", "default": "Subscribe" },
    { "type": "text", "id": "one_time_button_label", "label": "One-time purchase button label", "default": "Add to cart" },
    { "type": "text", "id": "reassurance_text", "label": "Reassurance note 1 (leave blank to hide)", "default": "Charged at each delivery" },
    { "type": "text", "id": "cancel_note", "label": "Reassurance note 2 (leave blank to hide)", "default": "Cancel from your account anytime" },

    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#1a1a1a" }
  ]
}
{% endschema %}
